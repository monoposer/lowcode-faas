# Meta (cmd/meta) listen
LOWCODE_FAAS_LISTEN=:8080

# Worker SDK (embedded in your process / examples/worker-embed)
LOWCODE_FAAS_WORKER_LISTEN=:9090
# Worker → meta (for metadata + compiled JS) — required by worker SDK
LOWCODE_FAAS_META_URL=http://127.0.0.1:8080

LOWCODE_FAAS_POSTGRES_DSN=postgres://faas:faas@localhost:5433/lowcode_faas?sslmode=disable

# S3-compatible OSS (meta only). source_url + js_url always stored here.
LOWCODE_FAAS_S3_ENDPOINT=http://127.0.0.1:9000
LOWCODE_FAAS_S3_REGION=us-east-1
LOWCODE_FAAS_S3_BUCKET=lowcode-faas
LOWCODE_FAAS_S3_ACCESS_KEY=rustfsadmin
LOWCODE_FAAS_S3_SECRET_KEY=rustfsadmin
LOWCODE_FAAS_S3_USE_PATH_STYLE=true
# Optional public URL base (default: {endpoint}/{bucket})
# LOWCODE_FAAS_S3_PUBLIC_BASE=http://127.0.0.1:9000/lowcode-faas

# FAAS_JS_MOCK=false

# Worker in-memory LRU for compiled JS (keyed by group+name; refreshed via etag / If-None-Match)
# LOWCODE_FAAS_JS_CACHE_SIZE=128

# Worker invoke logs (JSON via slog): debug|info|warn|error
# LOWCODE_FAAS_LOG_LEVEL=info
