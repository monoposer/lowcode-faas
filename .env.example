# 复制为 .env 后按需填写。dispatcher / worker 共用 LOWCODE_FAAS_*（监听变量仅 dispatcher 使用）。
# 加载方式：export $(grep -v '^#' .env | xargs)   或在 systemd / docker-compose 中逐项设置。
#
# Docker 构建基础镜像（仅 docker compose build 使用；Hub 拉取 EOF 时可换镜像加速前缀）：
# LOWCODE_FAAS_DOCKER_GO_IMAGE=docker.m.daocloud.io/library/golang:1.22-bookworm
# LOWCODE_FAAS_DOCKER_RUNTIME_IMAGE=docker.m.daocloud.io/library/debian:bookworm-slim

# --- Docker 中国区「镜像加速」（registry mirror，不是 HTTP_PROXY）---
# pull node 镜像由「宿主机」Docker 守护进程完成，须在宿主机配置，本仓库 .env 无法替代：
#   Docker Desktop → Settings → Docker Engine，JSON 示例：
#   "registry-mirrors": ["https://docker.m.daocloud.io"]
#   Linux：/etc/docker/daemon.json 同上，然后 sudo systemctl restart docker
# 若不便改 daemon，可用下面变量让运行时直接拉「镜像站上的全名」（与默认 node:22-alpine 等价路径）：
# LOWCODE_FAAS_NODE_DOCKER_IMAGE=docker.m.daocloud.io/library/node:22-alpine


# 未传 timeout_ms 时的默认 invoke 超时（毫秒），须大于首次 pull node 镜像耗时
# LOWCODE_FAAS_INVOKE_DEFAULT_TIMEOUT_MS=120000

# 启动后是否后台 docker pull Node 镜像（worker 始终执行；dispatcher 仅在不配置 WORKER_URL、本机跑 docker 时执行）
# LOWCODE_FAAS_PREWARM_NODE_IMAGE=false

# --- dispatcher 监听（仅 cmd/dispatcher 读取，默认 :8080）---
LOWCODE_FAAS_LISTEN=:8080

# --- worker（cmd/worker 默认 :9090；dispatcher 通过下列 URL 转发 invoke）---
LOWCODE_FAAS_WORKER_LISTEN=:9090
# LOWCODE_FAAS_WORKER_URL=http://127.0.0.1:9090

# --- 存储：files | db_s3 ---
LOWCODE_FAAS_STORAGE=files

# --- db_s3 时填写 ---
# LOWCODE_FAAS_POSTGRES_DSN=postgres://user:pass@localhost:5432/lowcode?sslmode=disable
# LOWCODE_FAAS_S3_ENDPOINT=http://127.0.0.1:9000
# LOWCODE_FAAS_S3_REGION=us-east-1
# LOWCODE_FAAS_S3_BUCKET=lowcode-faas
# LOWCODE_FAAS_S3_ACCESS_KEY=minio
# LOWCODE_FAAS_S3_SECRET_KEY=minio123
# LOWCODE_FAAS_S3_USE_PATH_STYLE=true

# --- 函数元数据缓存 ---
LOWCODE_FAAS_FUNCTION_CACHE=true

# --- 用户函数 console 采集（false 时仅容器 stdout，与原先一致）---
LOWCODE_FAAS_FUNCTION_LOGS=false
# stdout（带前缀）| docker_json | promtail（单行 JSON→Docker 日志→Promtail→Loki）| memory | elasticsearch | es | http | loki
LOWCODE_FAAS_FUNCTION_LOGS_SINK=stdout
# 可选：供 GET /function-logs/query 拼装浏览器打开 Grafana Explore 的链接（占位 {{logql}} {{run_id}} {{deployment_id}}）
# LOWCODE_FAAS_LOGS_GRAFANA_EXPLORE_URL_TEMPLATE=http://localhost:3000/explore?orgId=1&left=%5B%22now-1h%22,%22now%22,%22Loki%22,%7B%22expr%22%3A%22{{logql}}%22%7D%5D
LOWCODE_FAAS_FUNCTION_LOGS_BUFFER=10000
# LOWCODE_FAAS_LOG_LOKI_URL=http://127.0.0.1:3100
# LOWCODE_FAAS_LOG_LOKI_TENANT=
# LOWCODE_FAAS_LOG_LOKI_TIMEOUT_MS=8000
# LOWCODE_FAAS_LOG_ES_URL=http://localhost:9200
# LOWCODE_FAAS_LOG_ES_INDEX=lowcode-faas-logs
# LOWCODE_FAAS_LOG_ES_USER=
# LOWCODE_FAAS_LOG_ES_PASSWORD=
# LOWCODE_FAAS_LOG_HTTP_URL=https://example.com/hook
# LOWCODE_FAAS_LOG_HTTP_HEADER=Authorization: Bearer your-token
